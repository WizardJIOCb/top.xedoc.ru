[Unit]
Description=top.xedoc.ru leaderboard
After=network.target

[Service]
Type=simple
User=topxedoc
Group=topxedoc
WorkingDirectory=/var/www/top.xedoc.ru/current
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=4177
Environment=DATA_DIR=/var/www/top.xedoc.ru/data
ExecStart=/usr/bin/node dist/server/index.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/www/top.xedoc.ru/data

[Install]
WantedBy=multi-user.target
